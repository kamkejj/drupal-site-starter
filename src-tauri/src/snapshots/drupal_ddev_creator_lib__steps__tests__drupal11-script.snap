---
source: src/steps.rs
expression: script
---
#!/usr/bin/env bash
# Creates the DDEV Drupal project "mysite". Generated by Drupal DDEV Site Creator.
set -euo pipefail
export DDEV_NONINTERACTIVE=true

if [ -z "${DRUPAL_ADMIN_PASS:-}" ]; then
  read -rsp 'Drupal admin password: ' DRUPAL_ADMIN_PASS; echo
fi

cd /tmp

# Create the project folder
mkdir -p mysite
cd mysite

# Configure DDEV
ddev config --project-name=mysite --project-type=drupal11 --docroot=web --php-version=8.3 --webserver-type=nginx-fpm --database=mariadb:10.11

# Start DDEV
ddev start

# Download Drupal 11
ddev composer create-project drupal/recommended-project:^11 -n

# Add Drush
ddev composer require drush/drush -n

# Allow Composer plugin dealerdirect/phpcodesniffer-composer-installer
ddev composer config --no-plugins allow-plugins.dealerdirect/phpcodesniffer-composer-installer true

# Allow Composer plugin phpstan/extension-installer
ddev composer config --no-plugins allow-plugins.phpstan/extension-installer true

# Allow Composer plugin php-http/discovery
ddev composer config --no-plugins allow-plugins.php-http/discovery true

# Allow Composer plugin tbachert/spi
ddev composer config --no-plugins allow-plugins.tbachert/spi true

# Add code quality and testing tools (drupal/core-dev)
ddev composer require --dev drupal/core-dev:^11 --with-all-dependencies -n

# Add the Adminer add-on
ddev add-on get ddev/ddev-adminer

# Restart DDEV
ddev restart

# Write phpcs.xml.dist
cat > phpcs.xml.dist <<'DDEV_CREATOR_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="project">
  <description>Drupal coding standards for custom code.</description>
  <file>web/modules/custom</file>
  <file>web/themes/custom</file>
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
DDEV_CREATOR_EOF

# Write phpstan.neon
cat > phpstan.neon <<'DDEV_CREATOR_EOF'
parameters:
  level: 1
  paths:
    - web/modules/custom
    - web/themes/custom
DDEV_CREATOR_EOF

# Write phpunit.xml
cat > phpunit.xml <<'DDEV_CREATOR_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="web/core/tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <php>
    <ini name="error_reporting" value="32767"/>
    <ini name="memory_limit" value="-1"/>
    <env name="SIMPLETEST_BASE_URL" value="http://web" force="true"/>
    <env name="SIMPLETEST_DB" value="mysql://db:db@db/db" force="true"/>
    <env name="BROWSERTEST_OUTPUT_DIRECTORY" value="web/sites/simpletest/browser_output"/>
  </php>
  <testsuites>
    <testsuite name="unit">
      <directory>web/modules/custom/*/tests/src/Unit</directory>
    </testsuite>
    <testsuite name="kernel">
      <directory>web/modules/custom/*/tests/src/Kernel</directory>
    </testsuite>
    <testsuite name="functional">
      <directory>web/modules/custom/*/tests/src/Functional</directory>
    </testsuite>
    <testsuite name="functional-javascript">
      <directory>web/modules/custom/*/tests/src/FunctionalJavascript</directory>
    </testsuite>
  </testsuites>
</phpunit>
DDEV_CREATOR_EOF

# Write web/modules/custom/.gitkeep
mkdir -p web/modules/custom && touch web/modules/custom/.gitkeep

# Write web/themes/custom/.gitkeep
mkdir -p web/themes/custom && touch web/themes/custom/.gitkeep

# Add the composer lint script
ddev composer config scripts.lint 'if find web/modules/custom web/themes/custom -type f \( -name '\''*.php'\'' -o -name '\''*.module'\'' -o -name '\''*.inc'\'' -o -name '\''*.install'\'' -o -name '\''*.test'\'' -o -name '\''*.profile'\'' -o -name '\''*.theme'\'' -o -name '\''*.info'\'' -o -name '\''*.yml'\'' \) | grep -q .; then phpcs; else echo '\''No custom code to check yet.'\''; fi'

# Add the composer analyse script
ddev composer config scripts.analyse 'if find web/modules/custom web/themes/custom -type f \( -name '\''*.php'\'' -o -name '\''*.module'\'' -o -name '\''*.inc'\'' -o -name '\''*.install'\'' -o -name '\''*.theme'\'' -o -name '\''*.profile'\'' \) | grep -q .; then phpstan analyse --memory-limit=-1; else echo '\''No custom code to check yet.'\''; fi'

# Add the composer test script
ddev composer config scripts.test phpunit

# Create config/sync
mkdir -p config/sync

# Set config_sync_directory in settings.php
grep -qF '$settings['\''config_sync_directory'\''] = '\''../config/sync'\'';' web/sites/default/settings.php || \
  perl -0pi -e 's|^(\Q// Automatically generated include for settings managed by ddev.\E)|\$settings['\''config_sync_directory'\''] = '\''../config/sync'\'';\n\n$1|m' web/sites/default/settings.php

# Install Drupal
ddev drush site:install standard -y --account-name=admin --account-mail=me@example.com '--site-name=My Site'

# Set the admin password
printf '%s\n' "$DRUPAL_ADMIN_PASS" | ddev exec 'read -r p && drush user:password admin "$p"'

# Export configuration
ddev drush config:export -y

# Write protective .htaccess files
ddev drush php:eval '\Drupal::service('\''file.htaccess_writer'\'')->ensure();'

# Write .gitignore
cat > .gitignore <<'DDEV_CREATOR_EOF'
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/recipes/
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/settings.local.php
/web/sites/simpletest/
/.phpunit.cache/
.DS_Store
DDEV_CREATOR_EOF

# Initialize Git
git init -q

# Stage files
git add -A

# Create the first commit
git commit -q -m 'Initial Drupal site'
