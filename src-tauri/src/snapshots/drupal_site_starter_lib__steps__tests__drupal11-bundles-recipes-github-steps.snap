---
source: src/steps.rs
expression: summary(&steps)
---
mkdir: {"kind":"createProjectDir"}
ddev-config: {"kind":"ddev","args":["config","--project-name=mysite","--project-type=drupal11","--docroot=web","--php-version=8.3","--webserver-type=nginx-fpm","--database=mariadb:10.11"],"stdin_secret":false}
ddev-start: {"kind":"ddev","args":["start"],"stdin_secret":false}
create-project: {"kind":"ddev","args":["composer","create-project","drupal/recommended-project:^11","-n"],"stdin_secret":false}
drush: {"kind":"ddev","args":["composer","require","drush/drush","-n"],"stdin_secret":false}
allow-plugin:dealerdirect/phpcodesniffer-composer-installer: {"kind":"ddev","args":["composer","config","--no-plugins","allow-plugins.dealerdirect/phpcodesniffer-composer-installer","true"],"stdin_secret":false}
allow-plugin:phpstan/extension-installer: {"kind":"ddev","args":["composer","config","--no-plugins","allow-plugins.phpstan/extension-installer","true"],"stdin_secret":false}
allow-plugin:php-http/discovery: {"kind":"ddev","args":["composer","config","--no-plugins","allow-plugins.php-http/discovery","true"],"stdin_secret":false}
allow-plugin:tbachert/spi: {"kind":"ddev","args":["composer","config","--no-plugins","allow-plugins.tbachert/spi","true"],"stdin_secret":false}
core-dev: {"kind":"ddev","args":["composer","require","--dev","drupal/core-dev:^11","--with-all-dependencies","-n"],"stdin_secret":false}
addon:adminer: {"kind":"ddev","args":["add-on","get","ddev/ddev-adminer"],"stdin_secret":false}
ddev-restart: {"kind":"ddev","args":["restart"],"stdin_secret":false}
write:phpcs.xml.dist: write phpcs.xml.dist
write:phpstan.neon: write phpstan.neon
write:phpunit.xml: write phpunit.xml
write:web/modules/custom/.gitkeep: write web/modules/custom/.gitkeep
write:web/themes/custom/.gitkeep: write web/themes/custom/.gitkeep
script:lint: {"kind":"ddev","args":["composer","config","scripts.lint","if find web/modules/custom web/themes/custom -type f \\( -name '*.php' -o -name '*.module' -o -name '*.inc' -o -name '*.install' -o -name '*.test' -o -name '*.profile' -o -name '*.theme' -o -name '*.info' -o -name '*.yml' \\) | grep -q .; then phpcs; else echo 'No custom code to check yet.'; fi"],"stdin_secret":false}
script:analyse: {"kind":"ddev","args":["composer","config","scripts.analyse","if find web/modules/custom web/themes/custom -type f \\( -name '*.php' -o -name '*.module' -o -name '*.inc' -o -name '*.install' -o -name '*.theme' -o -name '*.profile' \\) | grep -q .; then phpstan analyse --memory-limit=-1; else echo 'No custom code to check yet.'; fi"],"stdin_secret":false}
script:test: {"kind":"ddev","args":["composer","config","scripts.test","phpunit"],"stdin_secret":false}
mkdir-config-sync: {"kind":"mkdir","path":"config/sync"}
settings-config-sync: {"kind":"setConfigSyncDir","dir":"../config/sync"}
site-install: {"kind":"ddev","args":["drush","site:install","standard","-y","--account-name=admin","--account-mail=me@example.com","--site-name=My Site"],"stdin_secret":false}
admin-password: {"kind":"ddev","args":["exec","read -r p && drush user:password admin \"$p\""],"stdin_secret":true}
bundle:admin:require: {"kind":"ddev","args":["composer","require","drupal/admin_toolbar","-n"],"stdin_secret":false}
bundle:admin:enable: {"kind":"ddev","args":["drush","pm:enable","-y","admin_toolbar","admin_toolbar_tools"],"stdin_secret":false}
bundle:dev:require: {"kind":"ddev","args":["composer","require","--dev","drupal/devel","drupal/stage_file_proxy","-n"],"stdin_secret":false}
bundle:dev:enable: {"kind":"ddev","args":["drush","pm:enable","-y","devel","stage_file_proxy"],"stdin_secret":false}
recipes:require: {"kind":"ddev","args":["composer","require","drupal/drupal_cms_seo_tools","drupal/drupal_cms_forms","-n"],"stdin_secret":false}
recipe:seo-tools: {"kind":"ddev","args":["drush","recipe","../recipes/drupal_cms_seo_tools","-y"],"stdin_secret":false}
recipe:forms: {"kind":"ddev","args":["drush","recipe","../recipes/drupal_cms_forms","-y"],"stdin_secret":false}
recipes:cache-rebuild: {"kind":"ddev","args":["drush","cache:rebuild"],"stdin_secret":false}
extra:enable: {"kind":"ddev","args":["drush","pm:enable","-y","media","admin_toolbar_search"],"stdin_secret":false}
write:.github/workflows/ci.yml: write .github/workflows/ci.yml
config-export: {"kind":"ddev","args":["drush","config:export","-y"],"stdin_secret":false}
htaccess: {"kind":"ddev","args":["drush","php:eval","\\Drupal::service('file.htaccess_writer')->ensure();"],"stdin_secret":false}
write:.gitignore: write .gitignore
git-init: {"kind":"git","args":["init","-q"]}
git-add: {"kind":"git","args":["add","-A"]}
git-commit: {"kind":"git","args":["commit","-q","-m","Initial Drupal site"]}
