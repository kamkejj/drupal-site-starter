{
  "revision": 1,
  "minDdevVersion": "1.24.0",
  "minDdevVersionPodman": "1.25.0",
  "composerPlugins": [
    "dealerdirect/phpcodesniffer-composer-installer",
    "phpstan/extension-installer",
    "php-http/discovery",
    "tbachert/spi"
  ],
  "drupal": [
    {
      "id": "12",
      "label": "Drupal 12",
      "package": "drupal/recommended-project:^12@beta",
      "ddevType": "drupal12",
      "installProfile": "standard",
      "composerConfig": [
        ["minimum-stability", "dev"],
        ["preferred-install.drupal/core", "source"]
      ],
      "reinstall": ["drupal/core"],
      "drushPackage": "drush/drush:^14",
      "devPackage": "drupal/core-dev:^12",
      "php": ["8.5"],
      "defaultPhp": "8.5",
      "databases": {
        "mariadb": ["10.11", "11.4", "11.8"],
        "mysql": ["8.0", "8.4"],
        "postgres": ["18"]
      },
      "defaultDatabase": { "type": "mariadb", "version": "11.8" },
      "status": "preview",
      "statusNote": "Drupal 12 is in beta. It uses a development build of Drush 14 and installs core from Git so its test tools are present. Many contributed modules don't support it yet."
    },
    {
      "id": "11",
      "label": "Drupal 11",
      "package": "drupal/recommended-project:^11",
      "ddevType": "drupal11",
      "installProfile": "standard",
      "drushPackage": "drush/drush",
      "devPackage": "drupal/core-dev:^11",
      "php": ["8.3", "8.4", "8.5"],
      "defaultPhp": "8.3",
      "databases": {
        "mariadb": ["10.6", "10.11", "11.4", "11.8"],
        "mysql": ["8.0", "8.4"],
        "postgres": ["16", "17"]
      },
      "defaultDatabase": { "type": "mariadb", "version": "10.11" },
      "status": "supported"
    },
    {
      "id": "cms",
      "label": "Drupal CMS",
      "package": "drupal/cms",
      "ddevType": "drupal11",
      "installProfile": "drupal_cms_installer",
      "drushPackage": "drush/drush",
      "devPackage": "drupal/core-dev:^11",
      "php": ["8.3", "8.4", "8.5"],
      "defaultPhp": "8.3",
      "databases": {
        "mariadb": ["10.6", "10.11", "11.4", "11.8"],
        "mysql": ["8.0", "8.4"],
        "postgres": ["16", "17"]
      },
      "defaultDatabase": { "type": "mariadb", "version": "10.11" },
      "status": "supported"
    },
    {
      "id": "10",
      "label": "Drupal 10",
      "package": "drupal/recommended-project:^10",
      "ddevType": "drupal10",
      "installProfile": "standard",
      "drushPackage": "drush/drush",
      "devPackage": "drupal/core-dev:^10",
      "php": ["8.1", "8.2", "8.3", "8.4"],
      "defaultPhp": "8.3",
      "databases": {
        "mariadb": ["10.6", "10.11", "11.4"],
        "mysql": ["8.0", "8.4"],
        "postgres": ["16", "17"]
      },
      "defaultDatabase": { "type": "mariadb", "version": "10.11" },
      "status": "ending-soon",
      "statusNote": "Drupal 10 reaches end of life around December 2026."
    }
  ],
  "services": [
    { "id": "mailpit", "label": "Mailpit", "addon": null, "wiring": { "kind": "none" }, "defaultOn": true },
    { "id": "adminer", "label": "Adminer", "addon": "ddev/ddev-adminer", "wiring": { "kind": "none" }, "defaultOn": true },
    {
      "id": "redis",
      "label": "Redis",
      "addon": "ddev/ddev-redis",
      "wiring": { "kind": "module", "packages": ["drupal/redis"], "modules": ["redis"] },
      "defaultOn": false
    },
    {
      "id": "solr",
      "label": "Solr",
      "addon": "ddev/ddev-solr",
      "wiring": {
        "kind": "module",
        "packages": ["drupal/search_api_solr"],
        "modules": ["search_api_solr", "search_api_solr_admin"],
        "setup": [
          {
            "title": "Create the Solr search server",
            "drush": ["php:eval", "$id = 'solr'; if (!\\Drupal\\search_api\\Entity\\Server::load($id)) { \\Drupal\\search_api\\Entity\\Server::create(['id' => $id, 'name' => 'Solr', 'backend' => 'search_api_solr', 'backend_config' => ['connector' => 'solr_cloud_basic_auth', 'connector_config' => ['scheme' => 'http', 'host' => 'solr', 'port' => 8983, 'path' => '/', 'core' => 'drupal', 'context' => 'solr', 'distrib' => TRUE, 'username' => 'solr', 'password' => 'SolrRocks']]])->save(); }"]
          },
          {
            "title": "Upload the Solr configset",
            "drush": ["search-api-solr:upload-configset", "--numShards=1", "solr"]
          }
        ]
      },
      "defaultOn": false
    },
    {
      "id": "elasticsearch",
      "label": "Elasticsearch",
      "addon": "ddev/ddev-elasticsearch",
      "wiring": {
        "kind": "module",
        "packages": ["drupal/elasticsearch_connector:^9.0@alpha"],
        "modules": ["elasticsearch_connector"],
        "setup": [
          {
            "title": "Create the Elasticsearch search server",
            "drush": ["php:eval", "$id = 'elasticsearch'; if (!\\Drupal\\search_api\\Entity\\Server::load($id)) { \\Drupal\\search_api\\Entity\\Server::create(['id' => $id, 'name' => 'Elasticsearch', 'backend' => 'elasticsearch', 'backend_config' => ['connector' => 'standard', 'connector_config' => ['url' => 'http://elasticsearch:9200', 'enable_debug_logging' => FALSE]]])->save(); }"]
          }
        ]
      },
      "defaultOn": false
    },
    { "id": "varnish", "label": "Varnish", "addon": "ddev/ddev-varnish", "wiring": { "kind": "containerOnly" }, "defaultOn": false },
    {
      "id": "memcached",
      "label": "Memcached",
      "addon": "ddev/ddev-memcached",
      "wiring": {
        "kind": "module",
        "packages": ["drupal/memcache"],
        "modules": ["memcache"],
        "settings": "$settings['memcache']['servers'] = ['memcached:11211' => 'default'];\n$settings['memcache']['bins'] = ['default' => 'default'];\n$settings['cache']['default'] = 'cache.backend.memcache';"
      },
      "defaultOn": false
    },
    { "id": "selenium", "label": "Selenium", "addon": "ddev/ddev-selenium-standalone-chrome", "wiring": { "kind": "none" }, "defaultOn": false }
  ],
  "bundles": [
    {
      "id": "admin",
      "label": "Admin essentials",
      "description": "Admin Toolbar with its extra menus.",
      "packages": ["drupal/admin_toolbar"],
      "modules": ["admin_toolbar", "admin_toolbar_tools"],
      "releases": ["11", "cms", "10"]
    },
    {
      "id": "seo",
      "label": "SEO basics",
      "description": "Pathauto, Metatag, Redirect and Simple XML Sitemap.",
      "packages": ["drupal/pathauto", "drupal/metatag", "drupal/redirect", "drupal/simple_sitemap"],
      "modules": ["pathauto", "metatag", "redirect", "simple_sitemap"],
      "releases": ["11", "cms", "10"]
    },
    {
      "id": "dev",
      "label": "Developer tools",
      "description": "Devel and Stage File Proxy, added as dev dependencies.",
      "packages": ["drupal/devel", "drupal/stage_file_proxy"],
      "dev": true,
      "modules": ["devel", "stage_file_proxy"],
      "releases": ["11", "cms", "10"]
    }
  ],
  "recipes": [
    {
      "id": "seo-tools",
      "label": "SEO tools",
      "description": "Meta tags, an XML sitemap, robots.txt management and an SEO checklist.",
      "package": "drupal/drupal_cms_seo_tools",
      "releases": ["11", "cms"]
    },
    {
      "id": "accessibility-tools",
      "label": "Accessibility tools",
      "description": "Editoria11y checks that flag accessibility problems while editors write.",
      "package": "drupal/drupal_cms_accessibility_tools",
      "releases": ["11", "cms"]
    },
    {
      "id": "privacy-basic",
      "label": "Privacy basics",
      "description": "Klaro consent management and blocking of remote content until consent.",
      "package": "drupal/drupal_cms_privacy_basic",
      "releases": ["11", "cms"]
    },
    {
      "id": "forms",
      "label": "Forms",
      "description": "A contact form plus Webform, with Honeypot and ALTCHA spam protection.",
      "package": "drupal/drupal_cms_forms",
      "releases": ["11", "cms"]
    }
  ]
}
